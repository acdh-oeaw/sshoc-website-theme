{% set classes = [
  'node',
  'node--type-scientific-publications',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
] %}

<article{{ attributes.addClass(classes) }}>
  {% if view_mode == 'teaser' %}
    <div class="news-block-two">
      {% if arcadia_scientific_publication_image %}
        {{ arcadia_scientific_publication_image }}
      {% endif %}

      <div class="inner-box">
        <h3{{ title_attributes }}><a href="{{ url }}">{{ label }}</a></h3>
        <div class="arcadia-scientific-publication-meta">
          {% if arcadia_scientific_publication_date %}
            {{ arcadia_scientific_publication_date }}
          {% endif %}
          {% if arcadia_scientific_publication_tagging %}
            {{ arcadia_scientific_publication_tagging }}
          {% endif %}
        </div>
        {{ content|without('field_date', 'field_image', 'field_tagging', 'field_url', 'field_source', 'links', 'comments') }}
      </div>
    </div>
  {% else %}
    <div class="post-thumbnail">
      <div class="event-info clearfix">
        {% if arcadia_scientific_publication_date %}
          <div class="date clearfix"><i class="fa fa-calendar"></i>{{ arcadia_scientific_publication_date }}</div>
        {% endif %}
      </div>

      {% if arcadia_scientific_publication_image %}
        {{ arcadia_scientific_publication_image }}
      {% endif %}

      <div class="items">
        {% if arcadia_scientific_publication_source %}
          <div class="item-attach">
            <div class="document clearfix"><span class="icon icon-papers"></span><span>{{ arcadia_scientific_publication_source }}</span></div>
          </div>
        {% endif %}

        {% if arcadia_scientific_publication_url %}
          <div class="item-attach">
            <div class="document clearfix"><span class="icon icon-network"></span><span>{{ arcadia_scientific_publication_url }}</span></div>
          </div>
        {% endif %}

        {% if arcadia_scientific_publication_tagging %}
          <div class="item-attach">
            <div class="document clearfix"><span class="icon icon-tags"></span><span>{{ arcadia_scientific_publication_tagging }}</span></div>
          </div>
        {% endif %}

        {% if content.field_file_attachment is defined %}
          <div class="item-attach">
            <div class="attach clearfix"><span><i class="fa fa-file"></i></span><span>{{ content.field_file_attachment }}</span></div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="content"{{ content_attributes }}>
      {{ content|without('field_date', 'field_image', 'field_tagging', 'field_source', 'field_url', 'field_file_attachment', 'field_document', 'field_attachment', 'links', 'comments') }}
    </div>

    {% if content.links is defined %}{{ content.links }}{% endif %}
    {% if content.comments is defined %}{{ content.comments }}{% endif %}
  {% endif %}
</article>
