{%
  set classes = [
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title }}
  {{ title_suffix }}

  {% if header %}
    <header>
      {{ header }}
    </header>
  {% endif %}

  {% if arcadia_service_catalogue_filter_links is not empty %}
    <nav class="arcadia-service-catalogue-filter" aria-label="{{ 'Service catalogue filter'|t }}">
      {% for item in arcadia_service_catalogue_filter_links %}
        <a class="arcadia-service-catalogue-filter__item{% if item.active %} is-active{% endif %}" href="{{ item.url }}">
          {% if item.icon %}
            <span class="arcadia-service-catalogue-filter__icon">
              <img alt="" src="{{ file_url('public://' ~ item.icon ~ '.png') }}">
            </span>
          {% endif %}
          <span class="arcadia-service-catalogue-filter__label">{{ item.title }}</span>
        </a>
      {% endfor %}
    </nav>
  {% endif %}

  {{ exposed }}
  {{ attachment_before }}

  {% if rows -%}
    {{ rows }}
  {% elseif empty -%}
    {{ empty }}
  {% endif %}
  {{ pager }}

  {{ attachment_after }}
  {{ more }}

  {% if footer %}
    <footer>
      {{ footer }}
    </footer>
  {% endif %}

  {{ feed_icons }}
</div>
