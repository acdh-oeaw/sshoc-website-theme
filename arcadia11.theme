<?php

declare(strict_types=1);

/**
 * @file
 * Theme hooks for Arcadia 11.
 */

use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\views\Views;

/**
 * Implements hook_preprocess_page().
 */
function arcadia11_preprocess_page(array &$variables): void {
  $variables['page_header_title'] = '';
  $variables['has_sidebar_second'] = FALSE;
  if (!empty($variables['page']['sidebar_second'])) {
    foreach (Element::children($variables['page']['sidebar_second']) as $child) {
      if (!empty($variables['page']['sidebar_second'][$child])) {
        $variables['has_sidebar_second'] = TRUE;
        break;
      }
    }
  }

  if (!$variables['has_sidebar_second'] && arcadia11_has_news_sidebar_context()) {
    $news_sidebar = arcadia11_build_news_sidebar();
    if ($news_sidebar !== []) {
      $variables['page']['sidebar_second']['arcadia11_news_sidebar'] = $news_sidebar;
      $variables['has_sidebar_second'] = TRUE;
    }
  }

  $variables['page_header_title'] = arcadia11_get_current_page_title();

  $variables['top_header_message'] = (string) theme_get_setting('top_header_message');
  $variables['services_title_block'] = (string) theme_get_setting('services_title_block');
  $variables['news_title_block'] = (string) theme_get_setting('news_title_block');
  $variables['footer_text_column_one'] = (string) theme_get_setting('footer_text_column_one');
  $variables['footer_text_column_two'] = (string) theme_get_setting('footer_text_column_two');
  $variables['footer_text_column_three'] = (string) theme_get_setting('footer_text_column_three');
  $variables['footer_text_column_four'] = (string) theme_get_setting('footer_text_column_four');
  $variables['text_footer'] = (string) theme_get_setting('text_footer');
  $variables['text_footer_left'] = (string) theme_get_setting('text_footer_left');
  $variables['text_footer_right'] = (string) theme_get_setting('text_footer_right');
  $variables['google_analytics_code'] = (string) theme_get_setting('google_analytics_code');

  $account = \Drupal::currentUser();
  $variables['login_url'] = Url::fromRoute('user.login')->toString();
  $variables['logout_url'] = Url::fromRoute('user.logout')->toString();
  $variables['user_url'] = $account->isAuthenticated()
    ? Url::fromRoute('entity.user.canonical', ['user' => $account->id()])->toString()
    : Url::fromRoute('user.login')->toString();

}

/**
 * Builds the news sidebar view for the /news page.
 */
function arcadia11_build_news_sidebar(): array {
  $view = Views::getView('news');
  if (!$view || !$view->access('block_2')) {
    return [];
  }

  return [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['arcadia-news-sidebar-container'],
    ],
    'content' => $view->buildRenderable('block_2'),
  ];
}

/**
 * Determines whether the current route should show the news sidebar.
 */
function arcadia11_has_news_sidebar_context(): bool {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() === 'view.news.page') {
    return TRUE;
  }

  $node = $route_match->getParameter('node');
  return $node instanceof NodeInterface && $node->bundle() === 'news';
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function arcadia11_preprocess_breadcrumb(array &$variables): void {
  $title = arcadia11_get_current_page_title();
  if ($title === '') {
    return;
  }

  $breadcrumb = $variables['breadcrumb'] ?? [];
  $last_item = end($breadcrumb);
  $last_text = is_array($last_item) && isset($last_item['text']) ? (string) $last_item['text'] : '';
  if ($last_text === $title) {
    return;
  }

  $variables['breadcrumb'][] = [
    'text' => $title,
  ];
}

/**
 * Returns the title used in the page header and final breadcrumb item.
 */
function arcadia11_get_current_page_title(): string {
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();

  $view_route_titles = [
    'view.news.page' => 'News',
    'view.partners.page' => 'Partners',
    'view.video.page' => 'SSHOC Videos',
    'view.video.page_1' => 'SSHOC Training Videos',
    'view.events.page' => 'SSHOC at Events',
    'view.events.page_1' => 'Past events',
    'view.events.page_2' => 'Page Training',
    'view.events.page_3' => 'Awareness Raising Events',
    'view.events.page_5' => 'Other Events',
    'view.service_catalogue.page' => 'Service Catalogue',
    'view.service_catalogue.page_1' => 'Service Catalogue',
  ];
  if (isset($view_route_titles[$route_name])) {
    return $view_route_titles[$route_name];
  }

  $node = $route_match->getParameter('node');
  if ($node instanceof NodeInterface) {
    return $node->label();
  }

  return '';
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function arcadia11_preprocess_views_view_fields(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view || $view->id() !== 'partners' || $view->current_display !== 'page') {
    return;
  }

  $node = $variables['row']->_entity ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'partner') {
    return;
  }

  $variables['arcadia_partner_title'] = $node->label();
  $variables['arcadia_partner_url'] = '';
  $variables['arcadia_partner_logo'] = [];

  if ($node->hasField('field_url') && !$node->get('field_url')->isEmpty()) {
    $variables['arcadia_partner_url'] = (string) $node->get('field_url')->first()->getUrl()->toString();
  }

  if ($node->hasField('field_logo') && !$node->get('field_logo')->isEmpty()) {
    $variables['arcadia_partner_logo'] = $node->get('field_logo')->view([
      'type' => 'image',
      'label' => 'hidden',
      'settings' => [
        'image_style' => 'logo_small',
        'image_link' => '',
      ],
    ]);
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function arcadia11_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  $variables['arcadia_service_catalogue_filter_links'] = [];

  if (!$view || $view->id() !== 'service_catalogue') {
    return;
  }

  $variables['arcadia_service_catalogue_filter_links'] = arcadia11_service_catalogue_filter_links();
}

/**
 * Implements hook_preprocess_views_exposed_form().
 */
function arcadia11_preprocess_views_exposed_form(array &$variables): void {
  $form = $variables['form'] ?? [];
  $form_id = (string) ($form['#id'] ?? '');
  $variables['arcadia_service_catalogue_filter_links'] = [];

  if (str_starts_with($form_id, 'views-exposed-form-service-catalogue-')) {
    $variables['arcadia_service_catalogue_filter_links'] = arcadia11_service_catalogue_filter_links();
    return;
  }

  if ($form_id !== 'views-exposed-form-events-page-2' || empty($form['field_tagging_target_id']['#options'])) {
    $variables['arcadia_training_event_filter_links'] = [];
    return;
  }

  $request = \Drupal::request();
  $current_query = $request->query->all();
  unset($current_query['page']);

  $selected = $current_query['field_tagging_target_id'] ?? [];
  if (!is_array($selected)) {
    $selected = [$selected];
  }
  $selected = array_map('strval', $selected);

  $links = [];
  foreach ($form['field_tagging_target_id']['#options'] as $value => $label) {
    if ((string) $value === '') {
      continue;
    }

    $value = (string) $value;
    $is_active = in_array($value, $selected, TRUE);
    $target_values = $selected;
    if ($is_active) {
      $target_values = array_values(array_diff($target_values, [$value]));
    }
    else {
      $target_values[] = $value;
    }

    $target_query = $current_query;
    if ($target_values === []) {
      unset($target_query['field_tagging_target_id']);
    }
    else {
      $target_query['field_tagging_target_id'] = array_values(array_unique($target_values));
    }

    $links[] = [
      'title' => (string) $label,
      'url' => Url::fromRoute('<current>', [], ['query' => $target_query])->toString(),
      'active' => $is_active,
    ];
  }

  $variables['arcadia_training_event_filter_links'] = $links;
}

/**
 * Builds the card-style Service Catalogue category filter.
 */
function arcadia11_service_catalogue_filter_links(): array {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $term_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'service_catalogue')
    ->execute();

  if (!$ids) {
    return [];
  }

  $terms = $term_storage->loadMultiple($ids);
  uasort($terms, static function ($a, $b): int {
    $order = arcadia11_service_catalogue_term_order();
    $a_weight = $order[(int) $a->id()] ?? 999;
    $b_weight = $order[(int) $b->id()] ?? 999;
    return $a_weight <=> $b_weight ?: strcasecmp($a->label(), $b->label());
  });

  $request = \Drupal::request();
  $query = $request->query->all();
  unset($query['page']);

  $selected = $query['field_service_catalogue_tid'] ?? [];
  if (!is_array($selected)) {
    $selected = $selected === '' ? [] : [$selected];
  }
  $selected = array_map('strval', $selected);

  $links = [];
  foreach ($terms as $term) {
    $term_id = (string) $term->id();
    $target_query = $query;
    $target_query['field_service_catalogue_tid'] = [$term_id];

    $links[] = [
      'title' => $term->label(),
      'url' => Url::fromUserInput('/service-catalogue', ['query' => $target_query])->toString(),
      'active' => in_array($term_id, $selected, TRUE),
      'icon' => arcadia11_service_catalogue_icon((int) $term->id()),
    ];
  }

  return $links;
}

/**
 * Legacy Service Catalogue category display order.
 */
function arcadia11_service_catalogue_term_order(): array {
  return [
    24 => 0,
    28 => 1,
    21 => 2,
    25 => 3,
    26 => 4,
    23 => 5,
    22 => 6,
    27 => 7,
  ];
}

/**
 * Maps service catalogue term IDs to legacy icon filenames.
 */
function arcadia11_service_catalogue_icon(int $term_id): string {
  $icon_map = [
    21 => 'networking',
    22 => 'storage',
    23 => 'sharing',
    24 => 'datamanagement',
    25 => 'processing',
    26 => 'security',
    27 => 'training',
    28 => 'datasets',
  ];

  return $icon_map[$term_id] ?? '';
}

/**
 * Implements hook_preprocess_node().
 */
function arcadia11_preprocess_node(array &$variables): void {
  if (empty($variables['node']) || !$variables['node'] instanceof NodeInterface) {
    return;
  }

  $node = $variables['node'];
  if ($node->bundle() === 'event') {
    $variables['arcadia_event_image'] = [];
    $variables['arcadia_event_date_range'] = arcadia11_format_event_date_range($node);
    $variables['arcadia_event_location'] = '';

    if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
      $variables['arcadia_event_image'] = $node->get('field_image')->view([
        'type' => 'image',
        'label' => 'hidden',
        'settings' => [
          'image_style' => 'responsive',
          'image_link' => '',
        ],
      ]);
    }

    if ($node->hasField('field_event_location') && !$node->get('field_event_location')->isEmpty()) {
      $variables['arcadia_event_location'] = (string) $node->get('field_event_location')->value;
    }
  }

  if ($node->bundle() === 'video') {
    $variables['sshoc_video_url'] = '';
    $variables['sshoc_video_embed_url'] = '';

    if ($node->hasField('field_video_embed') && !$node->get('field_video_embed')->isEmpty()) {
      $url = (string) $node->get('field_video_embed')->uri;
      $variables['sshoc_video_url'] = $url;
      $variables['sshoc_video_embed_url'] = arcadia11_youtube_embed_url($url);
    }
  }

  if ($node->bundle() === 'reportpresentation') {
    $variables['arcadia_reportpresentation_image'] = [];
    if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
      $variables['arcadia_reportpresentation_image'] = $node->get('field_image')->view([
        'type' => 'image',
        'label' => 'hidden',
        'settings' => [
          'image_style' => 'responsive',
          'image_link' => '',
        ],
      ]);
    }
  }

  if ($node->bundle() === 'scientific_publications') {
    $variables['arcadia_scientific_publication_image'] = [];
    $variables['arcadia_scientific_publication_date'] = [];
    $variables['arcadia_scientific_publication_tagging'] = [];
    $variables['arcadia_scientific_publication_url'] = [];
    $variables['arcadia_scientific_publication_source'] = [];

    if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
      $variables['arcadia_scientific_publication_image'] = $node->get('field_image')->view([
        'type' => 'image',
        'label' => 'hidden',
        'settings' => [
          'image_style' => 'responsive',
          'image_link' => '',
        ],
      ]);
    }

    foreach ([
      'field_date' => 'arcadia_scientific_publication_date',
      'field_tagging' => 'arcadia_scientific_publication_tagging',
      'field_url' => 'arcadia_scientific_publication_url',
      'field_source' => 'arcadia_scientific_publication_source',
    ] as $field_name => $variable_name) {
      if ($node->hasField($field_name) && !$node->get($field_name)->isEmpty()) {
        $variables[$variable_name] = $node->get($field_name)->view([
          'label' => 'hidden',
        ]);
      }
    }
  }

  if ($node->bundle() === 'news') {
    $variables['news_display_date'] = '';
    $variables['news_social_links'] = arcadia11_build_news_social_links($node);
    if ($node->hasField('field_date') && !$node->get('field_date')->isEmpty()) {
      $raw_date = (string) $node->get('field_date')->value;
      if ($raw_date !== '') {
        try {
          $timestamp = (new \DateTimeImmutable($raw_date))->getTimestamp();
          $variables['news_display_date'] = \Drupal::service('date.formatter')->format($timestamp, 'custom', 'j F Y');
        }
        catch (\Exception $exception) {
          $variables['news_display_date'] = '';
        }
      }
    }

    return;
  }

  if ($node->bundle() !== 'catalogue') {
    return;
  }

  $variables['catalogue_icon'] = '';
  if ($node->hasField('field_service_catalogue') && !$node->get('field_service_catalogue')->isEmpty()) {
    $term_id = (int) $node->get('field_service_catalogue')->target_id;
    $variables['catalogue_icon'] = arcadia11_service_catalogue_icon($term_id);
  }

  $variables['catalogue_type_label'] = arcadia11_node_referenced_term_labels($node, 'field_type');
  $variables['catalogue_property_label'] = arcadia11_node_referenced_term_labels($node, 'field_service_catalogue');
  $variables['catalogue_accessible_links'] = arcadia11_node_link_values($node, 'field_url');
  $variables['catalogue_factsheet_links'] = arcadia11_node_link_values($node, 'field_link');

  $variables['catalogue_related'] = [
    'deliverable' => [],
    'news' => [],
    'event' => [],
  ];

  if ($node->isNew()) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach (['deliverable', 'news', 'event'] as $bundle) {
    $ids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', $bundle)
      ->condition('status', 1)
      ->condition('field_catalogue.target_id', $node->id())
      ->sort('created', 'DESC')
      ->execute();

    if (empty($ids)) {
      continue;
    }

    /** @var \Drupal\node\NodeInterface[] $entities */
    $entities = $storage->loadMultiple($ids);
    foreach ($entities as $entity) {
      if (!$entity->access('view')) {
        continue;
      }
      $variables['catalogue_related'][$bundle][] = [
        'title' => $entity->label(),
        'url' => $entity->toUrl()->toString(),
      ];
    }
  }
}

/**
 * Returns referenced taxonomy term labels for a node field.
 */
function arcadia11_node_referenced_term_labels(NodeInterface $node, string $field_name): array {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return [];
  }

  $labels = [];
  foreach ($node->get($field_name)->referencedEntities() as $entity) {
    if (method_exists($entity, 'label')) {
      $labels[] = $entity->label();
    }
  }
  return $labels;
}

/**
 * Returns normalized link values for a node link field.
 */
function arcadia11_node_link_values(NodeInterface $node, string $field_name): array {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return [];
  }

  $links = [];
  foreach ($node->get($field_name) as $item) {
    try {
      $links[] = [
        'url' => $item->getUrl()->toString(),
        'title' => (string) ($item->title ?: $item->uri),
      ];
    }
    catch (\Exception $exception) {
      continue;
    }
  }
  return $links;
}

/**
 * Formats the imported D7 event start/end fields like the legacy listing.
 */
function arcadia11_format_event_date_range(NodeInterface $node): string {
  if (!$node->hasField('field_event_date') || $node->get('field_event_date')->isEmpty()) {
    return '';
  }

  $start_raw = (string) $node->get('field_event_date')->value;
  $end_raw = '';
  if ($node->hasField('field_event_date_end') && !$node->get('field_event_date_end')->isEmpty()) {
    $end_raw = (string) $node->get('field_event_date_end')->value;
  }
  elseif (isset($node->get('field_event_date')->first()->end_value)) {
    $end_raw = (string) $node->get('field_event_date')->first()->end_value;
  }

  try {
    $start = new \DateTimeImmutable($start_raw, new \DateTimeZone('UTC'));
    $end = $end_raw !== '' ? new \DateTimeImmutable($end_raw, new \DateTimeZone('UTC')) : NULL;
  }
  catch (\Exception $exception) {
    return '';
  }

  $formatter = \Drupal::service('date.formatter');
  $start_has_time = (bool) preg_match('/\d{2}:\d{2}/', $start_raw);
  $end_has_time = (bool) preg_match('/\d{2}:\d{2}/', $end_raw);
  $start_timestamp = $start->getTimestamp();
  $start_date = $formatter->format($start_timestamp, 'custom', 'd F Y');
  $start_time = $start_has_time ? $formatter->format($start_timestamp, 'custom', 'H:i') : '';

  if (!$end) {
    return $start_time !== '' ? $start_date . ' - ' . $start_time : $start_date;
  }

  $end_timestamp = $end->getTimestamp();
  $end_date = $formatter->format($end_timestamp, 'custom', 'd F Y');
  $end_time = $end_has_time ? $formatter->format($end_timestamp, 'custom', 'H:i') : '';

  if ($start_date === $end_date) {
    if ($start_time !== '' && $end_time !== '') {
      return $start_date . ' - ' . $start_time . ' to ' . $end_time;
    }
    return $start_date;
  }

  $start_label = $start_time !== '' ? $start_date . ' - ' . $start_time : $start_date;
  $end_label = $end_time !== '' ? $end_date . ' - ' . $end_time : $end_date;
  return $start_label . ' to ' . $end_label;
}

/**
 * Converts common YouTube URL formats into an embeddable URL.
 */
function arcadia11_youtube_embed_url(string $url): string {
  if ($url === '') {
    return '';
  }

  $parts = parse_url($url);
  if (empty($parts['host'])) {
    return '';
  }

  $host = strtolower((string) $parts['host']);
  $path = trim((string) ($parts['path'] ?? ''), '/');
  $video_id = '';

  if ($host === 'youtu.be') {
    $video_id = strtok($path, '/');
  }
  elseif (str_contains($host, 'youtube.com')) {
    if (str_starts_with($path, 'embed/')) {
      $video_id = substr($path, 6);
    }
    elseif (str_starts_with($path, 'shorts/')) {
      $video_id = substr($path, 7);
    }
    else {
      parse_str((string) ($parts['query'] ?? ''), $query);
      $video_id = (string) ($query['v'] ?? '');
    }
  }

  $video_id = preg_replace('/[^A-Za-z0-9_-]/', '', (string) $video_id);
  if ($video_id === '') {
    return '';
  }

  return 'https://www.youtube.com/embed/' . $video_id;
}

/**
 * Builds social share links for a news node.
 */
function arcadia11_build_news_social_links(NodeInterface $node): array {
  $absolute_url = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
  $title = $node->label();
  $summary = '';
  $theme_path = base_path() . \Drupal::service('extension.list.theme')->getPath('arcadia11');

  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_item = $node->get('body')->first();
    $summary_source = (string) ($body_item->summary ?: $body_item->value);
    $summary = trim(preg_replace('/\s+/', ' ', strip_tags($summary_source)) ?? '');
    if (function_exists('mb_substr') && function_exists('mb_strlen') && mb_strlen($summary) > 80) {
      $summary = rtrim(mb_substr($summary, 0, 77)) . '...';
    }
    elseif (strlen($summary) > 80) {
      $summary = rtrim(substr($summary, 0, 77)) . '...';
    }
  }

  $encoded_url = rawurlencode($absolute_url);
  $encoded_title = rawurlencode($title);
  $encoded_summary = rawurlencode($summary);

  return [
    [
      'item_class' => 'social-share-item-facebook first',
      'link_class' => 'social-share-facebook',
      'title' => 'Share to Facebook',
      'label' => 'Facebook',
      'icon_path' => $theme_path . '/images/icons/share-facebook-32.png',
      'href' => 'http://facebook.com/sharer.php?u=' . $encoded_url . '&t=' . $encoded_title,
    ],
    [
      'item_class' => 'social-share-item-linkedin',
      'link_class' => 'social-share-linkedin',
      'title' => 'Share to LinkedIn',
      'label' => 'LinkedIn',
      'icon_path' => $theme_path . '/images/icons/share-linkedin-32.png',
      'href' => 'http://www.linkedin.com/shareArticle?url=' . $encoded_url . '&mini=true&title=' . $encoded_title . '&ro=false&summary=' . $encoded_summary . '&source=',
    ],
    [
      'item_class' => 'social-share-item-twitter last',
      'link_class' => 'social-share-twitter',
      'title' => 'Share to Twitter',
      'label' => 'Twitter',
      'icon_path' => $theme_path . '/images/icons/share-twitter-32.png',
      'href' => 'http://twitter.com/intent/tweet?url=' . $encoded_url . '&text=' . $encoded_title,
    ],
  ];
}

/**
 * Implements hook_preprocess_html().
 */
function arcadia11_preprocess_html(array &$variables): void {
  $variables['google_analytics_code'] = (string) theme_get_setting('google_analytics_code');
}

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function arcadia11_form_system_theme_settings_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $form['arcadia11'] = [
    '#type' => 'details',
    '#title' => t('Arcadia 11 settings'),
    '#open' => TRUE,
  ];

  $form['arcadia11']['top_header_message'] = [
    '#type' => 'textfield',
    '#title' => t('Top header message'),
    '#default_value' => theme_get_setting('top_header_message'),
  ];

  $form['arcadia11']['google_analytics_code'] = [
    '#type' => 'textarea',
    '#title' => t('Google Analytics code snippet'),
    '#default_value' => theme_get_setting('google_analytics_code'),
  ];

  foreach ([
    'services_title_block' => 'Services block title',
    'news_title_block' => 'News block title',
    'text_footer' => 'Footer headline text',
    'text_footer_left' => 'Footer bottom left',
    'text_footer_right' => 'Footer bottom right',
  ] as $key => $label) {
    $form['arcadia11'][$key] = [
      '#type' => 'textfield',
      '#title' => t($label),
      '#default_value' => theme_get_setting($key),
    ];
  }

  foreach ([
    'footer_text_column_one' => 'Footer column one',
    'footer_text_column_two' => 'Footer column two',
    'footer_text_column_three' => 'Footer column three',
    'footer_text_column_four' => 'Footer column four',
  ] as $key => $label) {
    $form['arcadia11'][$key] = [
      '#type' => 'textarea',
      '#title' => t($label),
      '#default_value' => theme_get_setting($key),
    ];
  }
}
